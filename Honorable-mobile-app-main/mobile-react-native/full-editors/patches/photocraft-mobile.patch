diff --git a/apps/photocraft-web/src/noble_bridge.rs b/apps/photocraft-web/src/noble_bridge.rs
new file mode 100644
index 0000000..eff69b7
--- /dev/null
+++ b/apps/photocraft-web/src/noble_bridge.rs
@@ -0,0 +1,58 @@
+//! Local page adapter for Noble's bundled editor; no network listener or account access.
+use std::cell::RefCell;
+use std::sync::mpsc::{Sender, TryRecvError};
+use photocraft_ui_egui::ControlRequest;
+use wasm_bindgen::prelude::*;
+use wasm_bindgen::JsCast;
+use wasm_bindgen_futures::{JsFuture, future_to_promise};
+
+struct Host { tx: Sender<ControlRequest>, ctx: egui::Context, inbox: super::web::Inbox }
+thread_local! { static HOST: RefCell<Option<Host>> = const { RefCell::new(None) }; }
+pub fn install(tx: Sender<ControlRequest>, ctx: egui::Context, inbox: super::web::Inbox) {
+    HOST.with(|host| *host.borrow_mut() = Some(Host { tx, ctx, inbox }));
+}
+#[wasm_bindgen]
+pub fn noble_import(name: String, bytes: Vec<u8>) -> Result<(), JsValue> {
+    if name.is_empty() || name.len() > 120 || name.chars().any(|c| c.is_control() || c == '/' || c == '\\') || bytes.is_empty() || bytes.len() > 64 * 1024 * 1024 {
+        return Err(JsValue::from_str("Choose a named image or project up to64MB."));
+    }
+    HOST.with(|host| {
+        let borrow = host.borrow();
+        let host = borrow.as_ref().ok_or_else(|| JsValue::from_str("The image editor is not ready."))?;
+        let mut inbox = host.inbox.lock().map_err(|_| JsValue::from_str("The import queue is unavailable."))?;
+        if inbox.len() >= 8 { return Err(JsValue::from_str("Finish the current imports first.")); }
+        inbox.push((name, bytes)); host.ctx.request_repaint(); Ok(())
+    })
+}
+#[wasm_bindgen]
+pub fn noble_request(method: String, params: String) -> js_sys::Promise {
+    future_to_promise(async move {
+        if params.len() > 256 * 1024 || !matches!(method.as_str(), "engine.commands" | "engine.execute" | "ui.inspect" | "ui.menu.invoke" | "ui.key" | "ui.dialog.set" | "ui.dialog.apply" | "ui.dialog.cancel" | "app.save" | "jobs.list" | "jobs.cancel") {
+            return Err(JsValue::from_str("Unsupported local editor request."));
+        }
+        let params = serde_json::from_str(&params).map_err(|_| JsValue::from_str("Invalid local request data."))?;
+        let (request, receiver) = ControlRequest::new(method, params);
+        let dispatch = request.dispatch.clone();
+        HOST.with(|host| {
+            let borrow = host.borrow();
+            let host = borrow.as_ref().ok_or_else(|| JsValue::from_str("The image editor is not ready."))?;
+            host.tx.send(request).map_err(|_| JsValue::from_str("The image editor closed."))?;
+            host.ctx.request_repaint(); Ok::<(), JsValue>(())
+        })?;
+        let began = js_sys::Date::now();
+        loop {
+            match receiver.try_recv() {
+                Ok(reply) => return js_sys::JSON::parse(&reply.to_string()),
+                Err(TryRecvError::Disconnected) => return Err(JsValue::from_str("The image editor closed.")),
+                Err(TryRecvError::Empty) => {}
+            }
+            if js_sys::Date::now() - began > 120_000.0 { return Err(JsValue::from_str(&dispatch.give_up())); }
+            let delay = js_sys::Promise::new(&mut |resolve, reject| {
+                if let Some(window) = web_sys::window() {
+                    if let Err(error) = window.set_timeout_with_callback_and_timeout_and_arguments_0(resolve.unchecked_ref(), 16) { let _ = reject.call1(&JsValue::NULL, &error); }
+                } else { let _ = reject.call1(&JsValue::NULL, &JsValue::from_str("The image editor closed.")); }
+            });
+            JsFuture::from(delay).await?;
+        }
+    })
+}
