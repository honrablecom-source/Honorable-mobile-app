+/// When the selection has no paintable pixels, offer an editable layer before starting a stroke.
+/// Channel and mask strokes have their own target and stay on the ordinary tool path.
+fn prompt_for_missing_target(app: &mut PhotocraftApp, tool: Tool) -> bool {
+    let Some(st) = app.session.active() else { return false };
+    if crate::canvas::paint_target(app) != json!("pixels") {
+        return false;
+    }
+    let reason = match st.active_layer.and_then(|id| st.doc.layer(id)) {
+        None => "No layer is selected.",
+        Some(layer) if matches!(layer.content, photocraft_doc::LayerContent::Adjustment(_)) =>
+            "An adjustment changes the layers beneath it. Add a layer mask to brush where the adjustment applies.",
+        _ => return false,
+    };
+    if app.ui.dialogs.iter().any(|d| owns(&d.fields)) {
+        return true;
+    }
+    if let Some(layer) = available_pixel_layer(&st.doc) {
+        let fields = json!({
+            "__rasterize": "selectTarget", "__label": tool.label(),
+            "document": st.doc.id.0, "previous": st.active_layer.map(|id| id.0), "layer": layer.id.0,
+            "message": format!("{reason} Select “{}” to paint its pixels? Then draw your stroke again.", layer.name)
+        });
+        app.ui.open_dialog(DialogKind::Command, fields.as_object().unwrap().clone());
+    } else {
+        crate::brush_refusal::prompt(app, "Select a visible, unlocked pixel layer in Layers, or create a new pixel layer to paint on.");
+    }
+    true
+}
