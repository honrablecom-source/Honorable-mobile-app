+fn noble_photo_layers(s: &Session, p: &Value, cmd: &str) -> Result<Vec<Layer>> {
+    let current = s.active().ok_or(EngineError::NoDocument)?;
+    if p["documentId"].as_u64() != Some(current.doc.id.0) || p["revision"].as_u64() != Some(current.revision) {
+        return Err(bad(cmd, "the source photo changed; generate a new plan"));
+    }
+    let proposals = p["layers"].as_array().filter(|layers| (1..=4).contains(&layers.len()))
+        .ok_or_else(|| bad(cmd, "select one to four adjustments"))?;
+    proposals.iter().map(|row| {
+        let kind = row["kind"].as_str().filter(|kind| matches!(*kind, "brightnessContrast" | "hueSaturation" | "photoFilter" | "blackWhite"))
+            .ok_or_else(|| bad(cmd, "unsupported photo adjustment"))?;
+        let params = &row["params"];
+        let adjustment = crate::adjust_params::from_params(kind, params, None, current.doc.mode)?;
+        let name = params["name"].as_str().filter(|name| !name.is_empty() && name.len() <= 96)
+            .ok_or_else(|| bad(cmd, "provide a valid adjustment layer name"))?;
+        let opacity = match params.get("opacity") {
+            None => 1.0,
+            Some(value) => value.as_f64().filter(|amount| (0.0..=1.0).contains(amount))
+                .ok_or_else(|| bad(cmd, "opacity must be a number from 0 to 1"))? as f32,
+        };
+        let mut layer = Layer::new(name, LayerContent::Adjustment(adjustment));
+        layer.opacity = opacity;
+        Ok(layer)
+    }).collect()
+}
+
+fn noble_photo_preview(s: &mut Session, p: &Value) -> Result<Value> {
+    use base64::Engine as _;
+    use photocraft_codecs::{ChannelLayout, Format, Image};
+    const CMD: &str = "noble.photo.preview";
+    const EDGE: u32 = 960;
+    let layers = noble_photo_layers(s, p, CMD)?;
+    let source = &s.active().ok_or(EngineError::NoDocument)?.doc;
+    let mut copy = source.as_ref().clone();
+    copy.layers.extend(layers);
+    let before = photocraft_compose::thumbnail(source, EDGE);
+    let after = photocraft_compose::thumbnail(&copy, EDGE);
+    let (width, height) = (after.width, after.height);
+    let mut visible = 0;
+    let mut highlights = 0;
+    let mut shadows = 0;
+    for (old, new) in before.pixels.chunks_exact(4).zip(after.pixels.chunks_exact(4)) {
+        if old[3] < 224 || new[3] < 224 {
+            continue;
+        }
+        visible += 1;
+        if (0..3).any(|i| old[i] < 254 && new[i] >= 254) {
+            highlights += 1;
+        }
+        if old[..3].iter().any(|value| *value > 2) && new[..3].iter().all(|value| *value <= 2) {
+            shadows += 1;
+        }
+    }
+    let encode = |pixels| -> Result<String> {
+        let mut image = Image::from_u8(width, height, ChannelLayout::Rgba, pixels)
+            .map_err(|error| bad(CMD, error.to_string()))?;
+        if source.mode == ColorMode::Rgb {
+            image.icc = source.icc_profile.as_deref().cloned();
+        }
+        let bytes = photocraft_codecs::encode(&image, Format::Png, &Default::default())
+            .map_err(|error| bad(CMD, error.to_string()))?;
+        Ok(base64::engine::general_purpose::STANDARD.encode(bytes))
+    };
+    let original = if p["includeOriginal"].as_bool() == Some(true) { Some(encode(before.pixels)?) } else { None };
+    Ok(json!({
+        "width": width, "height": height, "original": original, "adjusted": encode(after.pixels)?,
+        "highlightClipping": highlights as f64 / visible.max(1) as f64,
+        "shadowClipping": shadows as f64 / visible.max(1) as f64,
+    }))
+}
