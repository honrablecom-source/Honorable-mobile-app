+fn available_pixel_layer(doc: &photocraft_doc::Document) -> Option<&photocraft_doc::Layer> {
+    doc.walk().into_iter().rev().find_map(|(path, _, layer)| {
+        let locks = doc.effective_locks(layer.id);
+        (matches!(layer.content, photocraft_doc::LayerContent::Raster(_))
+            && !(locks.pixels || locks.all)
+            && (1..=path.len()).all(|n| doc.layer_at(&path[..n]).is_some_and(|parent| parent.visible)))
+            .then_some(layer)
+    })
+}
