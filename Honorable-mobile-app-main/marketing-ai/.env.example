# Server
HOST=127.0.0.1
PORT=4173
PUBLIC_BASE_URL=http://127.0.0.1:4173
HONORABLE_WAITLIST_URL=http://127.0.0.1:4173/
AUTO_REPLY_DRY_RUN=true
AUTO_REPLY_RELEVANCE_THRESHOLD=85
AUTO_REPLY_SCORE_THRESHOLD=88
OUTREACH_PRODUCT_FIT_THRESHOLD=80
DATA_DIR=./data

# Development defaults: local JSON + simulated email + labeled mock discovery.
# Production: set WAITLIST_STORE=postgres and provide a TLS PostgreSQL URL.
WAITLIST_STORE=local-json
DATABASE_URL=
DISCOVERY_MODE=mock
DISCOVERY_QUERY_BUDGET=5
ZERO_COST_MODE=true
RSS_FEED_URLS=

# Resend development mode. RESEND_DEV_RECIPIENT must be the email address of
# the verified Resend account; resend.dev tests are never sent to waitlist users.
RESEND_API_KEY=
RESEND_DEV_FROM=Honorable Development <onboarding@resend.dev>
RESEND_DEV_RECIPIENT=

# Production email remains disabled until you own and verify a sending domain.
# EMAIL_FROM is intentionally retained for that future sender. If
# RESEND_DEV_RECIPIENT is blank, its mailbox is used as the locked test recipient.
EMAIL_PROVIDER=disabled
EMAIL_FROM=

# Official APIs only.
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Enable only after Reddit grants express approval for this commercial use.
REDDIT_COMMERCIAL_APPROVAL=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=HonorableMarketing/1.0 (contact: your-email@example.com)

# Optional Google Programmable Search free configuration, tried first.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Ignored while ZERO_COST_MODE=true.
BRAVE_SEARCH_API_KEY=

# Optional self-hosted topic-search provider. No public instance is assumed.
# Enable only engines whose use complies with their terms and robots policies.
SEARXNG_BASE_URL=
SEARXNG_ENGINES=

# No paid language model is used.
MARKETING_LLM_PROVIDER=local-rules
