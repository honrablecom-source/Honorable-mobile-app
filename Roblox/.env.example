NODE_ENV=development
HOST=127.0.0.1
PORT=4000
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/manager.db
ADMIN_USERNAME=admin
# Generate with: pnpm --filter @roblox-cloud/api hash-password
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=1$REPLACE_ME
SESSION_SECRET=replace-with-at-least-32-random-characters
AGENT_SHARED_SECRET=replace-with-a-different-32-character-secret
AGENT_ID=windows-vm-1
API_URL=https://my-roblox-cloud.example
GUACAMOLE_URL=https://desktop.my-roblox-cloud.example/guacamole/
GAMES_JSON=[{"name":"Example Experience","placeId":"1818"}]
AUTO_RECOVER=true
REOPEN_LAST_GAME=true
MAX_RESTARTS=5
STATUS_INTERVAL_ACTIVE_MS=10000
STATUS_INTERVAL_IDLE_MS=45000
