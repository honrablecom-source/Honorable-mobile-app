{
  "name": "roblox-cloud-manager",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.15.1",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=2 build",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "test": "vitest run",
    "dev": "pnpm --parallel --filter @roblox-cloud/api --filter @roblox-cloud/dashboard dev",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
